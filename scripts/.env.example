# Google Sheet Sync Configuration
# Copy this file to .env and fill in your actual values

# Google Sheet ID (from the URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit)
GOOGLE_SHEET_ID=15eTr34glBcYaJ9SBA_f5-sgr8mzQ_0fBHsjiKtenngE

# Google Sheet Tab Name (displayed on the specific tab selected)
# Defaults to the first index if not set
GOOGLE_SHEET_WORKSHEET_NAME=Synced Song Submission Status

# Path to your Google Service Account JSON file
GOOGLE_SERVICE_ACCOUNT_JSON_FILE=service_account.json